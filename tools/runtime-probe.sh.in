#!/bin/sh
# MIT. Render with prepare-runtime-probe.py; temporary RAM view only.
set -eu
PAYLOAD_SHA='@PAYLOAD_SHA@'
PAYLOAD_BYTES=@PAYLOAD_BYTES@
case "${1:-}" in
    --plan) echo "payload_sha256=$PAYLOAD_SHA bytes=$PAYLOAD_BYTES"; exit 0 ;;
    run) [ "$#" -eq 1 ] || exit 2 ;;
    *) echo 'Usage: runtime-probe.sh --plan | run' >&2; exit 2 ;;
esac
die() { echo "STOP: $*" >&2; exit 1; }
mounted() { grep -F " $1 " /proc/mounts >/dev/null; }
ROOT=/data/.stowaways/sailfishos
[ "$(id -u)" = 0 ] || die 'Run in the existing initramfs root shell'
grep -Eq '(^|[[:space:]])n100_debug=1([[:space:]]|$)' /proc/cmdline || die 'Early-debug flag missing'
grep -Eq '(^|[[:space:]])androidboot.slot_suffix=_b([[:space:]]|$)' /proc/cmdline || die 'Expected slot B'
grep -Eq '^/dev/sda16 /data ext4 ro(,| )' /proc/mounts || die 'Expected read-only userdata mount'
[ -d "$ROOT/usr/libexec/droid-hybris/system" ] || die 'Built Android HAL system tree missing'
if grep -F '/tmp/n100-runtime-probe.' /proc/mounts >/dev/null; then
    die 'A previous runtime-probe mount remains; inspect its cleanup first'
fi
work=$(mktemp -d /tmp/n100-runtime-probe.XXXXXX)
P=$work/root
mounts=
loop=
cleanup() {
    rc=$?
    trap - 0 HUP INT TERM
    set +e
    failed=0
    for point in $mounts; do
        if mounted "$point" && ! umount "$point"; then failed=1; fi
    done
    if [ -n "$loop" ]; then
        backing=/sys/class/block/${loop##*/}/loop/backing_file
        if [ -r "$backing" ]; then
            case "$(cat "$backing")" in
                "$work/payload.img"|"${work#/}/payload.img")
                    if ! losetup -d "$loop"; then failed=1; fi ;;
                *) echo 'Refusing to detach a foreign loop backing file'; failed=1 ;;
            esac
        fi
    fi
    echo "N100_RUNTIME_PROBE_RESULT exit=$rc cleanup_failed=$failed"
    echo "RAM work directory: $work"
    if [ "$failed" != 0 ] && [ "$rc" = 0 ]; then rc=1; fi
    exit "$rc"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' HUP TERM

echo 'N100 temporary Android Runtime probe V1'
echo "Kernel: $(uname -r)"
wget -O "$work/payload.img" http://192.168.2.14:8081/apex_payload.img
[ "$(wc -c < "$work/payload.img")" -eq "$PAYLOAD_BYTES" ] || die 'Payload size mismatch'
actual=$(sha256sum "$work/payload.img"); actual=${actual%% *}
[ "$actual" = "$PAYLOAD_SHA" ] || die 'Payload hash mismatch'
echo "Verified payload SHA-256: $actual"

mkdir "$work/runtime" "$work/ram" "$P"
loop=$(losetup -f)
case "$loop" in /dev/loop[0-9]*) ;; *) die 'Unexpected loop device name' ;; esac
losetup -r "$loop" "$work/payload.img"
[ "$(cat /sys/class/block/${loop##*/}/ro)" = 1 ] || die 'Loop device is not read-only'
mounts="$work/runtime $mounts"
mount -t ext4 -o ro,noload "$loop" "$work/runtime"
while read -r path size expected; do
    file=$work/runtime/$path
    [ -f "$file" ] && [ "$(wc -c < "$file")" -eq "$size" ] || die "Missing or changed core file: $path"
    actual=$(sha256sum "$file"); actual=${actual%% *}
    [ "$actual" = "$expected" ] || die "Core file hash mismatch: $path"
    echo "Verified runtime core: $path"
done <<'N100_CORE_FILES'
@FILE_CHECKS@
N100_CORE_FILES

mounts="$work/ram $mounts"
mount -t tmpfs -o size=32m,mode=0700,nosuid,nodev tmpfs "$work/ram"
mkdir "$work/ram/upper" "$work/ram/overlay-work"
mounts="$P $mounts"
mount -t overlay overlay -o "lowerdir=$ROOT,upperdir=$work/ram/upper,workdir=$work/ram/overlay-work,index=off" "$P"
for leaf in dev proc sys; do
    [ -d "$P/$leaf" ] || die "Missing rootfs mountpoint: $leaf"
    mounts="$P/$leaf $mounts"
    mount --bind "/$leaf" "$P/$leaf"
done
[ ! -e "$P/system" ] && [ ! -L "$P/system" ] || die 'Unexpected existing /system in lower rootfs'
[ ! -e "$P/apex/com.android.runtime" ] && [ ! -L "$P/apex/com.android.runtime" ] || die 'Runtime is already present in lower rootfs'
mkdir "$P/system" "$P/apex/com.android.runtime"
mounts="$P/system $mounts"
mount --bind "$ROOT/usr/libexec/droid-hybris/system" "$P/system"
mounts="$P/apex/com.android.runtime $mounts"
mount --bind "$work/runtime" "$P/apex/com.android.runtime"
echo '=== Temporary mount view ==='
grep -F " $P" /proc/mounts || :

echo '=== Android linker64 --help ==='
timeout 15 chroot "$P" /bin/sh -c '
LD_LIBRARY_PATH=/system/lib64:/apex/com.android.runtime/lib64/bionic /apex/com.android.runtime/bin/linker64 --help
'
echo 'N100_LINKER_HELP_EXIT=0'
for program in /system/bin/getprop /system/bin/linkerconfig /system/bin/servicemanager /system/bin/hwservicemanager; do
    echo "=== Dependency listing: $program ==="
    if timeout 15 chroot "$P" /bin/sh -c '
        [ -x "$1" ] || { echo "NOT_BUILT: $1"; exit 3; }
        LD_LIBRARY_PATH=/system/lib64:/apex/com.android.runtime/lib64/bionic /apex/com.android.runtime/bin/linker64 --list "$1"
    ' n100-list "$program"; then
        echo "N100_DEPENDENCY_EXIT $program 0"
    else
        code=$?
        echo "N100_DEPENDENCY_EXIT $program $code"
    fi
done
echo 'Android application/service main functions were not requested; dependency-list mode only.'
echo 'Persistent Sailfish /apex and userdata contents remain unchanged.'
# EXIT trap unmounts views and detaches only our own loop device.
